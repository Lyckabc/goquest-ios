<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>home.toji.woodpecker-agent</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/dong-hoshin/.local/bin/woodpecker-agent</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>WOODPECKER_SERVER</key>
        <string>127.0.0.1:9000</string>
        <key>WOODPECKER_GRPC_SECURE</key>
        <string>false</string>
        <key>WOODPECKER_AGENT_SECRET</key>
        <!-- Inject from the woodpecker-server StatefulSet env. Replace this
             placeholder before `launchctl load`; do NOT commit the actual secret.
             Pull at install time:
               kubectl -n metaflow get sts woodpecker-server \
                 -o jsonpath='{.spec.template.spec.containers[0].env[?(@.name=="WOODPECKER_AGENT_SECRET")].value}'
        -->
        <string>REPLACE_ME_WITH_AGENT_SECRET</string>
        <key>WOODPECKER_AGENT_CONFIG_FILE</key>
        <string>/Users/dong-hoshin/Library/Application Support/Woodpecker/agent.conf</string>
        <key>WOODPECKER_BACKEND</key>
        <string>local</string>
        <key>WOODPECKER_BACKEND_LOCAL_TEMP_DIR</key>
        <string>/Users/dong-hoshin/Library/Caches/Woodpecker</string>
        <key>WOODPECKER_HOSTNAME</key>
        <string>mac-toji-arm64</string>
        <key>WOODPECKER_MAX_WORKFLOWS</key>
        <string>2</string>
        <key>WOODPECKER_FILTER_LABELS</key>
        <string>platform=darwin/arm64</string>
        <key>WOODPECKER_LOG_LEVEL</key>
        <string>info</string>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/Users/dong-hoshin/Library/Logs/Woodpecker/agent.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/dong-hoshin/Library/Logs/Woodpecker/agent.err.log</string>

    <key>WorkingDirectory</key>
    <string>/Users/dong-hoshin</string>
</dict>
</plist>
